# ==========================================================
# SISTEMA DE TURNOS — VARIABLES DE ENTORNO
# ==========================================================

# URL de la Aplicación Web desplegada en Google Apps Script (modo legacy/fallback)
WEBHOOK_URL=https://script.google.com/macros/s/TU_WEBHOOK_URL_AQUI/exec

# Estado de notificaciones (true/false)
NOTIFICACIONES_ACTIVAS=true

# ==========================================================
# CONFIGURACIÓN SMTP (para envío de correos con adjuntos)
# ==========================================================
# Para Gmail:
#   1. Activa la Verificación en 2 pasos en tu cuenta Google
#   2. Ve a: https://myaccount.google.com/apppasswords
#   3. Genera una Contraseña de Aplicación para "Correo"
#   4. Copia la contraseña de 16 caracteres aquí (sin espacios)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_USE_TLS=true
SMTP_FROM_NAME=Sistema de Turnos
